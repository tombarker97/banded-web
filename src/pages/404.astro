---
import BaseLayout from "~/layouts/BaseLayout.astro";
import Footer from "~/components/Footer.astro";
---

<BaseLayout
  title="Page not found — Banded"
  description="The page you're looking for doesn't exist on banded.uk."
  noindex
>
  <main class="not-found">
    <div class="wordmark">404</div>
    <p class="tagline">
      This page doesn't exist on banded.uk. It may have moved, or you may have followed
      a broken link.
    </p>
    <a class="cta" href="/">Back to Banded</a>
  </main>

  <Footer variant="centered" />
</BaseLayout>

<style>
  main.not-found {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 60px 24px;
    text-align: center;
  }

  .wordmark {
    font-size: 96px;
    font-weight: 800;
    letter-spacing: -3px;
    margin-bottom: 16px;
    background: var(--gradient-wordmark);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    line-height: 1;
  }

  .tagline {
    font-size: 20px;
    color: var(--color-muted);
    max-width: 460px;
    margin-bottom: 36px;
    line-height: 1.5;
    text-wrap: balance;
  }

  .cta {
    display: inline-block;
    padding: 12px 22px;
    border-radius: var(--radius-md);
    background: var(--color-accent);
    color: var(--color-text);
    font-size: 15px;
    font-weight: 600;
  }

  .cta:hover {
    background: var(--color-accent-strong);
    color: var(--color-text);
  }

  @media (max-width: 480px) {
    .wordmark {
      font-size: 72px;
    }
    .tagline {
      font-size: 17px;
    }
  }
</style>
