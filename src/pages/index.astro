---
import BaseLayout from "~/layouts/BaseLayout.astro";
import Footer from "~/components/Footer.astro";
import WaitlistForm from "~/components/WaitlistForm.astro";

const site = Astro.site?.toString().replace(/\/$/, "") ?? "https://banded.uk";

const organisation = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Banded",
  url: site,
  logo: `${site}/favicon.svg`,
  email: "hello@banded.uk",
  sameAs: [
    "https://apps.apple.com/gb/app/banded-gig-diary-discovery/id6761863648",
  ],
};

const webSite = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Banded",
  url: site,
  description:
    "Banded is the social gig diary. Log every concert, rate the experience, and share your live music history.",
  publisher: { "@type": "Organization", name: "Banded" },
};

const softwareApplication = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Banded — Gig Diary",
  alternateName: ["Banded", "Letterboxd for concerts", "Letterboxd for gigs"],
  applicationCategory: "MusicApplication",
  operatingSystem: "iOS 17.0 or later",
  description:
    "Banded is a free iOS app that lets you log every gig you've been to, rate artists and venues, share your live music history, and discover upcoming shows. Often described as Letterboxd for concerts.",
  url: site,
  downloadUrl:
    "https://apps.apple.com/gb/app/banded-gig-diary-discovery/id6761863648",
  installUrl:
    "https://apps.apple.com/gb/app/banded-gig-diary-discovery/id6761863648",
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "GBP",
  },
  author: { "@type": "Organization", name: "Banded" },
  publisher: { "@type": "Organization", name: "Banded" },
};

const title = "Banded — The Social Gig Diary";
const description =
  "Your gig diary — like social media for music. Log every show, rate it, share it to socials, remember it forever. Free on the App Store.";

const features = [
  {
    title: "Log your gigs",
    body: "Artist, venue, rating, written review, support acts, the friends you went with.",
  },
  {
    title: "Import your past in seconds",
    body: "Pull your ticket history from any app — Banded turns a decade of gigs into a proper diary in one go.",
  },
  {
    title: "See what your friends are at",
    body: "Follow the people you go to gigs with. Their feed, their comments, alerts when there's overlap.",
  },
  {
    title: "Discover tonight's gig",
    body: "Interactive Gig Map — pinned by venue, filtered by genre, sorted by who's playing. Anywhere you are.",
  },
  {
    title: "Brag, modestly",
    body: "One-tap polaroid share cards for Instagram Stories. Custom themes, your stats, your photos.",
  },
  {
    title: "Your year in gigs",
    body: "Every December: top artists, top venues, monthly heatmap, the shows that defined your year.",
  },
];
---

<BaseLayout
  title={title}
  description={description}
  schemas={[organisation, webSite, softwareApplication]}
>
  <main class="home">
    <div class="wordmark">banded</div>
    <p class="tagline">Your gig diary — like social media for music.</p>
    <p class="lede">Log every show. Rate it. Share it. Remember it forever.</p>

    <a
      class="app-store-badge"
      href="https://apps.apple.com/gb/app/banded-gig-diary-discovery/id6761863648"
      target="_blank"
      rel="noopener"
      aria-label="Download Banded on the App Store"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true" xmlns="http://www.w3.org/2000/svg"
        ><path
          d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"
        ></path></svg
      >
      <span><small>Download on the</small>App Store</span>
    </a>

    <section class="features" aria-label="What Banded does">
      {features.map((f) => (
        <article class="feature">
          <h3>{f.title}</h3>
          <p>{f.body}</p>
        </article>
      ))}
    </section>

    <p class="about-line">
      <strong>Free forever</strong> — Pro and Backstage unlock detailed Year-in-Review
      stats, custom share-card themes, and unlimited imports. Made in London by a music
      fan who wanted a better way to remember his gigs.
    </p>

    <WaitlistForm />

    <nav class="discovery-nav" aria-label="Read more">
      <a href="/blog" class="is-primary">Read the blog &rarr;</a>
      <a href="/help">Help articles</a>
      <a href="/support">Support</a>
    </nav>
  </main>

  <Footer variant="centered" />
</BaseLayout>

<style>
  main.home {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 72px 24px;
    text-align: center;
  }

  .wordmark {
    font-family: "Clash Display", -apple-system, BlinkMacSystemFont,
      "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    font-size: 96px;
    font-weight: 700;
    letter-spacing: -4px;
    line-height: 0.95;
    margin-bottom: 16px;
    background: var(--gradient-wordmark);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .tagline {
    font-size: 22px;
    color: var(--color-text);
    max-width: 580px;
    margin-bottom: 8px;
    line-height: 1.4;
    text-wrap: balance;
    font-weight: 500;
  }

  .lede {
    font-size: 17px;
    color: var(--color-muted);
    max-width: 520px;
    margin-bottom: 40px;
    line-height: 1.5;
    text-wrap: balance;
  }

  .features {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 28px 32px;
    max-width: 920px;
    width: 100%;
    margin-bottom: 40px;
    text-align: left;
  }

  .feature h3 {
    font-size: 16px;
    font-weight: 600;
    color: var(--color-text);
    margin: 0 0 6px;
    letter-spacing: -0.2px;
  }

  .feature p {
    font-size: 14.5px;
    color: var(--color-body);
    line-height: 1.55;
    margin: 0;
  }

  .about-line {
    font-size: 14px;
    color: var(--color-muted);
    max-width: 720px;
    margin-bottom: 48px;
    line-height: 1.65;
    text-wrap: balance;
  }

  .about-line strong {
    color: var(--color-text);
    font-weight: 600;
  }

  .app-store-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 200px;
    height: 60px;
    border-radius: var(--radius-lg);
    background: #ffffff;
    color: #000000;
    text-decoration: none;
    margin-bottom: 56px;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.25);
  }

  .app-store-badge:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.32);
    color: #000000;
  }

  .app-store-badge svg {
    width: 28px;
    height: 28px;
    fill: #000000;
  }

  .app-store-badge span {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    line-height: 1.1;
    font-weight: 600;
    font-size: 19px;
    letter-spacing: -0.3px;
  }

  .app-store-badge small {
    font-size: 10px;
    font-weight: 400;
    letter-spacing: 0.4px;
    text-transform: uppercase;
    opacity: 0.75;
    margin-bottom: 2px;
  }

  .discovery-nav {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 8px;
  }

  .discovery-nav a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 10px 18px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-card-border);
    background: var(--color-card-bg);
    color: var(--color-text);
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    transition: border-color 0.15s ease, background 0.15s ease, transform 0.15s ease;
  }

  .discovery-nav a:hover {
    border-color: var(--color-accent-card-border);
    background: var(--color-accent-card-bg);
    color: var(--color-accent-hover);
    transform: translateY(-1px);
  }

  .discovery-nav a.is-primary {
    border-color: var(--color-accent);
    background: var(--color-accent);
    color: #ffffff;
  }

  .discovery-nav a.is-primary:hover {
    background: var(--color-accent-strong);
    border-color: var(--color-accent-strong);
    color: #ffffff;
  }

  @media (max-width: 480px) {
    .wordmark {
      font-size: 64px;
      letter-spacing: -3px;
    }
    .tagline {
      font-size: 19px;
    }
    .lede {
      font-size: 16px;
    }
    .features {
      gap: 24px;
    }
  }
</style>
