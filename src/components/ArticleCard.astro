---
interface Props {
  href: string;
  title: string;
  description: string;
  category?: string;
  readTime?: string;
}

const { href, title, description, category, readTime } = Astro.props;
---

<a class="article-card" href={href}>
  {(category || readTime) && (
    <div class="card-meta">
      {category && <span class="card-category">{category}</span>}
      {readTime && <span class="card-read-time">{readTime}</span>}
    </div>
  )}
  <h3>{title}</h3>
  <p>{description}</p>
  <span class="read-more">Read article &rarr;</span>
</a>

<style>
  .article-card {
    display: block;
    text-decoration: none;
    background: var(--color-card-bg);
    border: 1px solid var(--color-card-border);
    border-radius: var(--radius-lg);
    padding: 24px;
    transition: transform 0.15s ease, border-color 0.15s ease,
      background 0.15s ease;
  }

  .article-card:hover {
    transform: translateY(-2px);
    border-color: var(--color-accent-card-border);
    background: var(--color-accent-card-bg);
  }

  .card-meta {
    display: flex;
    gap: 10px;
    align-items: center;
    margin-bottom: 12px;
  }

  .card-category {
    display: inline-block;
    font-size: 12px;
    color: var(--color-accent);
    background: rgba(59, 130, 246, 0.12);
    padding: 2px 10px;
    border-radius: var(--radius-pill);
    letter-spacing: 0.4px;
    text-transform: uppercase;
    font-weight: 600;
  }

  .card-read-time {
    font-size: 12px;
    color: var(--color-muted);
  }

  .article-card h3 {
    font-size: 19px;
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: 10px;
    line-height: 1.3;
  }

  .article-card p {
    color: var(--color-body);
    font-size: 15px;
    line-height: 1.55;
    margin-bottom: 16px;
  }

  .read-more {
    color: var(--color-accent);
    font-size: 14px;
    font-weight: 500;
  }

  .article-card:hover .read-more {
    color: var(--color-accent-hover);
  }
</style>
